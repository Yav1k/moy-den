# Скопируй этот файл в .env.local и заполни значениями из настроек своего проекта Supabase
# (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email, которому разрешён вход в приложение (единственный пользователь)
NEXT_PUBLIC_ALLOWED_EMAIL=you@example.com

# Push-уведомления (сгенерировать: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
APP_TIMEZONE=Asia/Yekaterinburg
# Произвольная секретная строка — её же указать в pg_cron при вызове /api/send-reminders
CRON_SECRET=

# Project Settings -> API -> Secret keys. Только на сервере, никогда в NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
